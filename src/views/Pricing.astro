---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Band from '../components/Band.astro';
import PriceList, { type PriceItem } from '../components/PriceList.astro';
import Faq from '../components/Faq.astro';
import services from '../data/services.json';
import { breadcrumbs } from '../lib/structured-data';
import { site } from '../site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);
const p = t.pricing;
const serviceText = t.services as Record<string, { title: string }>;
---

<Base
  lang={lang}
  pageId="pricing"
  title={p.meta.title}
  description={p.meta.description}
  jsonLd={[breadcrumbs(lang, 'pricing', p.breadcrumb)]}
>
  <Section tone="lines" divider={false} padding="pt-14 pb-20 sm:pt-20 sm:pb-28">
    <div class="max-w-2xl">
      <h1 class="title-page">{p.title}</h1>
      <p class="mt-5 lead">{p.lead}</p>
      <a href={`#${t.anchors.faq}`} class="mt-6 btn btn-outline">{p.toFaq}</a>
    </div>

    <div class="mt-14 grid gap-x-16 gap-y-12 lg:grid-cols-2">
      {
        services.map((s) => (
          <PriceList lang={lang} id={s.id} title={serviceText[s.id].title} items={s.prices as PriceItem[]} />
        ))
      }
    </div>
  </Section>

  <Section id={t.anchors.faq} tone="raised" inner="grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <div>
      <h2 class="title-section">{t.faq.title}</h2>
      <p class="mt-5 max-w-sm lead">{t.faq.lead}</p>
    </div>
    <Faq lang={lang} />
  </Section>

  <Section padding="pt-20" inner="text-center">
    <h2 class="text-5xl display sm:text-6xl">{p.cta.title}</h2>
    <p class="mx-auto mt-4 max-w-xl lead">{p.cta.text}</p>

    <div slot="after" class="overflow-hidden pt-10 pb-16">
      <Band href={site.phoneHref} class="mx-auto block w-[min(100%-2rem,40rem)] py-4 text-center">
        <span class="block text-4xl display sm:text-6xl">{site.phone}</span>
      </Band>
    </div>
  </Section>
</Base>
