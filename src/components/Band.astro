---
// Link rendered on a skewed accent background (styles: .band in global.css).
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  /** Plays the one-time entrance animation. */
  animated?: boolean;
}

const { animated = false, class: className, ...attrs } = Astro.props;
---

<a class:list={['band', animated && 'band-wipe', className]} {...attrs}><slot /></a>
