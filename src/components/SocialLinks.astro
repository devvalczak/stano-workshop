---
// Icon links to the social profiles configured in .env (renders nothing when none are set).
import Icon from './Icon.astro';
import { site } from '../site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const { t } = useTranslations(lang);
---

{
  site.social.length > 0 && (
    <ul class:list={['flex gap-3', className]}>
      {site.social.map(({ id, url }) => (
        <li class="flex">
          <a
            href={url}
            target="_blank"
            rel="noopener"
            class="grid aspect-square min-h-11 place-items-center border border-silver/40 transition-colors hover:border-caliper hover:text-caliper"
            aria-label={t.social[id]}
          >
            <Icon name={id} class="h-5 w-5" />
          </a>
        </li>
      ))}
    </ul>
  )
}
