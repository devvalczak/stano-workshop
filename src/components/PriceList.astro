---
// One service group of the price list: heading plus rows with dotted leaders.
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n';

export interface PriceItem {
  id: string;
  price: number | null;
  perHour?: boolean;
}

interface Props {
  lang: Lang;
  id: string;
  title: string;
  items: PriceItem[];
}

const { lang, id, title, items } = Astro.props;
const { t } = useTranslations(lang);
const p = t.pricing;
const names: Record<string, string> = p.names;

const amount = (item: PriceItem) => item.price ?? '…';
const label = (item: PriceItem) =>
  item.perHour ? `${amount(item)} ${p.perHour}` : `${p.from} ${amount(item)} ${p.currency}`;
---

<section aria-labelledby={`price-${id}`}>
  <h2 id={`price-${id}`} class="flex items-center gap-3 text-3xl display-md sm:text-4xl">
    <Icon name="chevron" class="h-6 w-6 shrink-0 text-caliper" />
    <span>{title}</span>
  </h2>
  <ul class="mt-4 border-t border-graphite">
    {
      items.map((item) => (
        <li class="flex items-baseline gap-3 border-b border-graphite/60 py-3">
          <span>{names[item.id] ?? item.id}</span>
          <span class="min-w-6 flex-1 border-b border-dotted border-silver/40" aria-hidden="true" />
          <span class="font-semibold whitespace-nowrap">{label(item)}</span>
        </li>
      ))
    }
  </ul>
</section>
