---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Callbar from '../components/Callbar.astro';
import { site, absolute, url } from '../site';
import { defaultLang, languages, locales, routes, useTranslations, type Lang, type PageId } from '../i18n';

interface Props {
  lang: Lang;
  /** Omit for pages without language versions (404): no canonical/hreflang, noindex. */
  pageId?: PageId;
  title: string;
  description?: string;
  jsonLd?: object[];
  /** Id of the element after which the call bar appears (see Callbar.astro). */
  callbarRevealAfter?: string;
}

const { lang, pageId, title, description, jsonLd = [], callbarRevealAfter } = Astro.props;
const { t } = useTranslations(lang);
const canonical = pageId ? absolute(routes[pageId][lang]) : undefined;
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {
      pageId ? (
        <>
          <link rel="canonical" href={canonical} />
          {languages.map((l) => (
            <link rel="alternate" hreflang={l} href={absolute(routes[pageId][l])} />
          ))}
          <link rel="alternate" hreflang="x-default" href={absolute(routes[pageId][defaultLang])} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={absolute('/og-image.jpg')} />
    <meta property="og:locale" content={t.ogLocale} />
    {
      languages
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={locales[l].ogLocale} />)
    }
    <meta name="theme-color" content="#0E0F11" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <!-- Applies the stored theme before first paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {
        /* storage unavailable */
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira:ital,wdth,wght@0,50..125,100..900;1,50..125,100..900&display=swap"
      rel="stylesheet"
    />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>

  <body class="overflow-x-hidden antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-caliper focus:px-4 focus:py-2 focus:text-white"
    >
      {t.a11y.skip}
    </a>

    <Header lang={lang} pageId={pageId} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <Callbar lang={lang} revealAfter={callbarRevealAfter} />

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
