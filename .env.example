# Copy to .env and fill in. .env is git-ignored; CI recreates it from the ENV_FILE secret (see CLAUDE.md).
# Site settings, read at build time (src/site.ts, astro.config.mjs).
# Restart `npm run dev` after changing this file.

# Public URL without a trailing slash, plus the path the site is served under.
# GitHub Pages project site: SITE_URL=https://<user>.github.io, BASE_PATH=/<repo>
# Custom domain:             SITE_URL=https://example.com,     BASE_PATH=/
SITE_URL=https://example.github.io
BASE_PATH=/repo-name

BUSINESS_NAME=ExampleWorkshop

# Displayed as written; the tel: link is built from PHONE_COUNTRY_CODE + digits of PHONE.
PHONE=500 000 000
PHONE_COUNTRY_CODE=+48

ADDRESS_STREET=Example Street 1
ADDRESS_POSTAL_CODE=00-000
ADDRESS_CITY=Example City
# Optional: city in the Polish locative case ("w {cityLocative}"). Defaults to ADDRESS_CITY.
ADDRESS_CITY_LOCATIVE=Example City
ADDRESS_COUNTRY=PL

# HH:MM
HOURS_OPEN=07:00
HOURS_CLOSE=17:00
# Comma-separated day codes: Mo,Tu,We,Th,Fr,Sa,Su. Empty → only hours are shown and no opening hours go to JSON-LD.
OPENING_DAYS=

# Optional. Used in JSON-LD (geo, sameAs).
GEO_LAT=
GEO_LNG=
GOOGLE_PROFILE_URL=
FACEBOOK_URL=
